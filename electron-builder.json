{
  "appId": "com.hamster.diogen",
  "productName": "Хомячок Диоген",
  "executableName": "HamsterDiogen",
  "copyright": "Copyright © 2026 DiogenDev",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/**/*",
    "out/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "electron/wallpaper-helper.exe",
      "to": "wallpaper-helper.exe"
    }
  ],
  "compression": "normal",
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      },
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "electron/icon.ico",
    "artifactName": "HamsterDiogen-Setup.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Хомячок Диоген"
  }
}
